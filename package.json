{
  "name": "vision-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed:admin": "node --env-file=.env.local scripts/seed-admin.mjs",
    "seed:nova": "node --env-file=.env.local scripts/seed-nova.mjs",
    "seed:admin:prod": "node --env-file=.env.atlas scripts/seed-admin.mjs",
    "seed:nova:prod": "node --env-file=.env.atlas scripts/seed-nova.mjs",
    "seed:projects": "node --env-file=.env.local scripts/seed-projects.mjs",
    "seed:projects:prod": "node --env-file=.env.atlas scripts/seed-projects.mjs",
    "fix:order": "node --env-file=.env.local scripts/backfill-order.mjs",
    "fix:order:prod": "node --env-file=.env.atlas scripts/backfill-order.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.10",
    "mongoose": "^9.9.4",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
